{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://soundcheck.dev/schemas/manifest.schema.json",
  "title": "CapabilityManifest",
  "description": "Validation schema for Soundcheck system capability manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "host",
    "summary",
    "agents",
    "resolvedRoles"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Soundcheck manifest specification version"
    },
    "generatedAt": {
      "type": "string",
      "description": "ISO-8601 generation timestamp"
    },
    "host": {
      "type": "object",
      "required": ["platform", "gitWorktree"],
      "properties": {
        "platform": { "type": "string" },
        "nodeVersion": { "type": "string" },
        "gitWorktree": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "totalAgents",
        "functionalAgents",
        "cooldownsActive",
        "quirksProtected"
      ],
      "properties": {
        "totalAgents": { "type": "integer", "minimum": 0 },
        "functionalAgents": { "type": "integer", "minimum": 0 },
        "cooldownsActive": { "type": "integer", "minimum": 0 },
        "quirksProtected": { "type": "integer", "minimum": 0 }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "installed",
          "authValid",
          "functional",
          "cooldownActive",
          "errorClass",
          "models",
          "permissions"
        ],
        "properties": {
          "installed": { "type": "boolean" },
          "version": { "type": "string" },
          "authValid": { "type": "boolean" },
          "functional": { "type": "boolean" },
          "cooldownActive": { "type": "boolean" },
          "cooldownUntil": { "type": ["integer", "null"] },
          "errorClass": { "type": "string" },
          "models": {
            "type": "array",
            "items": { "type": "string" }
          },
          "permissions": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "resolvedRoles": {
      "type": "object",
      "required": ["primary", "subagent", "auxiliary", "reviewer"],
      "properties": {
        "primary": { "$ref": "#/definitions/resolved_role" },
        "subagent": { "$ref": "#/definitions/resolved_role" },
        "auxiliary": { "$ref": "#/definitions/resolved_role" },
        "reviewer": { "$ref": "#/definitions/resolved_role" }
      },
      "additionalProperties": { "$ref": "#/definitions/resolved_role" }
    }
  },
  "definitions": {
    "resolved_role": {
      "type": "object",
      "required": ["agent", "model", "vendor", "reason"],
      "properties": {
        "agent": { "type": "string" },
        "model": { "type": "string" },
        "vendor": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
